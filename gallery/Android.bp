//
// HyperOS Gallery and Editor Port (LLions)
//

android_app_import {
    name: "HyperOSGallery",
    apk: "HyperOSGallery.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "HyperOSEditor",
    apk: "HyperOSEditor.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}
